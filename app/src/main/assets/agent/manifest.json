{
  "manifest_version": 2,
  "name": "Browser Agent Bridge",
  "version": "1.1",
  "description": "Lets the Browser Agent app read pages, perform actions in them and save them for offline reading.",
  "browser_specific_settings": {
    "gecko": {
      "id": "agent@browseragent.app"
    }
  },
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ],
  "permissions": ["nativeMessaging", "nativeMessagingFromContent", "geckoViewAddons", "<all_urls>"]
}
