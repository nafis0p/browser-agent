{
  "manifest_version": 2,
  "name": "Browser Agent Bridge",
  "version": "1.0",
  "description": "Lets the Browser Agent app read pages and perform actions in them.",
  "browser_specific_settings": {
    "gecko": {
      "id": "agent@browseragent.app"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ],
  "permissions": ["nativeMessaging", "nativeMessagingFromContent", "geckoViewAddons"]
}
